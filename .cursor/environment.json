{
  "name": "MDS Jupyter Notebooks",
  "install": "pip install --user -r requirements.txt",
  "terminals": [
    {
      "name": "jupyter-lab",
      "command": "python3 -m jupyterlab --ip=0.0.0.0 --port=8888 --no-browser --ServerApp.token='' --ServerApp.password='' --IdentityProvider.token='' --ServerApp.disable_check_xsrf=True"
    }
  ],
  "ports": [8888]
}
