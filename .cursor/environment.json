{
  "name": "MDS Notebooks",
  "install": "pip3 install --user -r requirements.txt",
  "terminals": [
    {
      "name": "jupyterlab",
      "command": "export PATH=\"$HOME/.local/bin:$PATH\" && jupyter lab --ip=0.0.0.0 --port=8888 --no-browser --ServerApp.token='' --ServerApp.password='' --ServerApp.disable_check_xsrf=True"
    }
  ],
  "ports": [8888]
}
